<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#0A1120" android:fillViewport="true">

  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="vertical" android:padding="20dp">

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/app_name" android:textColor="#E2E8F0"
        android:textSize="22sp" android:textStyle="bold" />

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/subtitulo" android:textColor="#7488A6"
        android:textSize="12sp" android:layout_marginTop="2dp" android:layout_marginBottom="18dp" />

    <!-- el semáforo general: lo primero y lo más grande -->
    <TextView android:id="@+id/tvEstado" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="—"
        android:textSize="24sp" android:textStyle="bold" android:textColor="#94A3B8"
        android:background="#0F1B2E" android:padding="18dp" />

    <!-- checklist de salud: se llena solo en pintar() (una fila por chequeo, tocá para activar) -->
    <LinearLayout android:id="@+id/listaSalud" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="vertical"
        android:layout_marginTop="10dp" android:layout_marginBottom="14dp" />

    <TextView android:id="@+id/tvDetalle" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textColor="#93A4C2" android:textSize="12sp"
        android:lineSpacingExtra="4dp" android:padding="14dp" android:background="#0C1626"
        android:layout_marginBottom="16dp" />

    <Button android:id="@+id/btnActualizar" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/actualizar"
        android:backgroundTint="#0EA5E9" android:textColor="#FFFFFF" />

    <Button android:id="@+id/btnProbar" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/probar"
        android:backgroundTint="#1E293B" android:textColor="#94A3B8"
        android:textSize="12sp" android:layout_marginTop="8dp" />

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/pie" android:textColor="#475569" android:textSize="11sp"
        android:layout_marginTop="22dp" />
  </LinearLayout>
</ScrollView>
